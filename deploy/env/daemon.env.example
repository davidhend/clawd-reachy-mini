# Reachy SDK daemon env. Copy to /etc/reachy-openclaw/daemon.env.

# Required to download the emotion/dance datasets non-interactively on first
# boot. Get one at https://huggingface.co/settings/tokens (read-only is enough).
HF_TOKEN=replace-me

# Datasets cached on disk. The setup script primes them on install; this var
# lets the daemon find them if the user account moves.
HF_HOME=/opt/reachy-openclaw/hf-cache
