# SSH tunnel to OpenClaw gateway. Copy to /etc/reachy-openclaw/tunnel.env.
# chmod 600 and chown root:reachy after editing.

# Host running OpenClaw gateway.
REMOTE_HOST=192.168.1.100
REMOTE_USER=your-user

# Gateway ports. Local and remote can match — the OpenClaw host binds the gateway on
# loopback, the tunnel just exposes it on this host's loopback too.
LOCAL_PORT=18789
REMOTE_PORT=18789

# Key used only for this tunnel. /etc/reachy-openclaw is root-owned (mode 750),
# so generate the key as root, then give it to the reachy user:
#   sudo ssh-keygen -t ed25519 -N "" -f /etc/reachy-openclaw/tunnel_key
#   sudo chown reachy:reachy /etc/reachy-openclaw/tunnel_key{,.pub}
#   sudo chmod 600 /etc/reachy-openclaw/tunnel_key
SSH_KEY=/etc/reachy-openclaw/tunnel_key
