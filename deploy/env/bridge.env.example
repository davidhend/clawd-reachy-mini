# Reachy <-> OpenClaw bridge runtime config. Copy to /etc/reachy-openclaw/bridge.env.
# chmod 600 and chown root:reachy after editing.

# Local end of the SSH tunnel to the OpenClaw gateway.
LOCAL_PORT=18789

# OpenClaw gateway auth.
OPENCLAW_TOKEN=replace-me

# Speech-to-text. faster-whisper is the fastest CPU option; whisper is the
# vanilla openai-whisper package. "openai" hits the cloud API and needs
# OPENCLAW_OPENAI_TOKEN or OPENAI_API_KEY.
STT_BACKEND=faster-whisper
WHISPER_MODEL=base

# Wake word. Substring-matched against the transcript; pick something Whisper
# will reliably hear. Set to a single space to disable (the unit's --wake-word
# flag is required).
WAKE_WORD=hey gizmo

# Conversation follow-up window (seconds). After a wake or any exchange, speech
# is sent to the agent WITHOUT the wake word for this long; the timer resets on
# every exchange. Keep it short so ambient meeting speech doesn't keep the robot
# "awake" indefinitely. Default in code is 45; 15 is a calmer value.
WAKE_SESSION_SECONDS=15

# ElevenLabs TTS. Powers BOTH conversational replies and the reachy_say tool.
# REACHY_ELEVENLABS_API_KEY is REQUIRED for any speech — without it the robot
# moves but stays silent. REACHY_ELEVENLABS_VOICE_ID is optional (defaults to a
# premade voice).
REACHY_ELEVENLABS_API_KEY=replace-me
# REACHY_ELEVENLABS_VOICE_ID=

# Audio device names. Run `aplay -l` / `arecord -l` after the udev rule is
# loaded to confirm. Leave blank to use the system default device, which on a
# headless box will be whichever USB device showed up first.
# REACHY_AUDIO_INPUT=
# REACHY_AUDIO_OUTPUT=

# Per-unit head roll calibration (radians). Some units lean slightly at
# commanded roll 0; adjust until the head reads as level (e.g. -0.12).
# REACHY_ROLL_TRIM=0.0
